DATABASE_URI=postgresql://payload:payload@localhost:5432/zum_zum_enterprises
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PREVIEW_SECRET=replace-with-a-separate-random-preview-secret

# Production S3-compatible storage (Cloudflare R2, AWS S3, or equivalent)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
S3_CLIENT_UPLOADS=true

# Optional SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Zum Zum Enterprises
CONTACT_NOTIFICATION_EMAIL=
SEND_ENQUIRY_CONFIRMATION=false

# Optional Cloudflare Turnstile protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
