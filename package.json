{
  "name": "zum-zum-enterprises",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --no-server-fast-refresh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern src/payload-types.ts --ignore-pattern src/migrations",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "payload": "payload",
    "payload:generate-types": "payload generate:types",
    "payload:generate-importmap": "payload generate:importmap",
    "payload:migrate:create": "payload migrate:create",
    "payload:migrate": "payload migrate",
    "payload:migrate:status": "payload migrate:status",
    "seed": "payload run src/seed/index.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/email-nodemailer": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "framer-motion": "^12.42.2",
    "graphql": "16.12.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.6",
    "nodemailer": "7.0.11",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "type": "module",
  "displayName": "Zum Zum Enterprises"
}
